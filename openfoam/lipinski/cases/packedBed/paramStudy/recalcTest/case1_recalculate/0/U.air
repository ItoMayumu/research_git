// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    object          U.air;
}

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0 0 0.116819 );

boundaryField
{
    INLET
    {
        type            fixedValue;
        value           uniform ( 0 0 0.116819 );
    }
    OUTLET
    {
        type            pressureInletOutletVelocity;
        phi             phi.air;
        value           uniform ( 0 0 0.116819 );
    }
    WALL
    {
        type            fixedValue;
        value           uniform ( 0 0 0 );
    }
}


// ************************************************************************* //

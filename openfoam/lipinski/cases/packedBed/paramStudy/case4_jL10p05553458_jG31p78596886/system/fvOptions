FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          fvOptions;
}

porosity_air
{
    type            explicitPorositySource;
    active          true;
    explicitPorositySourceCoeffs
    {
        type            DarcyForchheimer;
        selectionMode   cellZone;
        cellZone        porosity1;
        U               U.air;
        rho             thermo:rho;
        coordinateSystem
        {
            type            cartesian;
            origin          ( 0 0 0 );
            rotation
            {
                type            axes;
                e1              ( 1 0 0 );
                e2              ( 0 1 0 );
            }
        }
        d               ( 2.74083e+08 2.74083e+08 2.74083e+08 );
        f               ( 20759.9 20759.9 20759.9 );
    }
}

